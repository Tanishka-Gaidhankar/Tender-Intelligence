# ==========================================
# Tender Intelligence System - Environment Config
# ==========================================

# LLM Provider Configuration
# Supported providers: groq, cohere, gemini, openai, anthropic, ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# API Keys (Provide key for your active LLM provider)
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama Host (If using provider=ollama)
OLLAMA_HOST=http://localhost:11434/api/generate

# Web Dashboard Server Port
PORT=5000

# Tender Portal Credentials (Used for automated login)
TENDER247_USERNAME=your_tender247_email@domain.com
TENDER247_PASSWORD=your_tender247_password

TENDERDETAIL_USERNAME=your_tenderdetail_username
TENDERDETAIL_PASSWORD=your_tenderdetail_password

# Gmail IMAP Credentials (For automated digest email intake)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
